{
  "manifest_version": 3,
  "name": "Agent Shield",
  "version": "0.7.0",
  "description": "Protects you from AI threats while browsing. Detects hidden manipulation, prompt injection, and scams — all locally.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/shield-green-16.png",
      "32": "icons/shield-green-32.png",
      "48": "icons/shield-green-48.png",
      "128": "icons/shield-green-128.png"
    },
    "default_title": "Agent Shield - Click to see scan results"
  },
  "icons": {
    "16": "icons/shield-green-16.png",
    "32": "icons/shield-green-32.png",
    "48": "icons/shield-green-48.png",
    "128": "icons/shield-green-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/detector.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "commands": {
    "rescan-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Rescan the current page with Agent Shield"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
