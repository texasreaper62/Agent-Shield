# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_RESOURCE_GROUP=rg-va-claims-dev
AZURE_LOCATION=eastus

# Database
DATABASE_URL=postgresql://user:password@host:5432/vaclaims
PGVECTOR_CONNECTION_STRING=postgresql://user:password@host:5432/vaclaims

# Azure Storage
AZURE_STORAGE_ACCOUNT=vaclaimsstorage
AZURE_STORAGE_KEY=your-storage-key
AZURE_BLOB_CONTAINER=documents

# Azure Service Bus
AZURE_SERVICE_BUS_CONNECTION_STRING=your-service-bus-connection-string
AZURE_SERVICE_BUS_QUEUE_DOCUMENTS=document-processing
AZURE_SERVICE_BUS_QUEUE_CLAIMS=claim-analysis

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Application
SECRET_KEY=generate-a-secure-random-key
JWT_SECRET=generate-a-secure-jwt-secret
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# VA APIs
VA_BENEFITS_INTAKE_API_URL=https://sandbox-api.va.gov/services/vba_documents/v1
VA_FORMS_API_URL=https://sandbox-api.va.gov/services/va_forms/v0
VA_API_KEY=your-va-api-key

# Feature Flags
ENABLE_AUTO_SUBMISSION=false
REQUIRE_ATTORNEY_APPROVAL=true
